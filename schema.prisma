// ============================================================
// Credit Repair Platform — Prisma Schema (Phase 1 + data model
// for Phases 2-3 so later phases don't require breaking migrations)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  CREDIT_SPECIALIST
  COMPLIANCE_ADMIN
  CLIENT
}

enum ClientStatus {
  LEAD
  ONBOARDING
  DOCUMENTS_NEEDED
  REPORTS_NEEDED
  AUDIT_PENDING
  STRATEGY_PENDING
  READY_FOR_ROUND_1
  ROUND_1_PENDING
  ROUND_2_PENDING
  ROUND_3_PENDING
  ESCALATION
  MONITORING
  COMPLETED
  PAUSED
  CANCELLED
}

enum Bureau {
  EXPERIAN
  EQUIFAX
  TRANSUNION
}

enum DocumentCategory {
  DRIVER_LICENSE
  STATE_ID
  SSN_CARD
  PROOF_OF_ADDRESS
  UTILITY_BILL
  BANK_STATEMENT
  CREDIT_REPORT
  FTC_IDENTITY_THEFT_REPORT
  POLICE_REPORT
  AFFIDAVIT
  BUREAU_LETTER
  CREDITOR_LETTER
  FURNISHER_CORRESPONDENCE
  CFPB_COMPLAINT
  SUPPORTING_EVIDENCE
  MAILING_RECEIPT
  CERTIFIED_MAIL_TRACKING
  BUREAU_RESPONSE
  UPDATED_CREDIT_REPORT
  SIGNED_AGREEMENT
  OTHER
}

enum NegativeCategory {
  COLLECTION
  CHARGE_OFF
  LATE_PAYMENT
  REPOSSESSION
  FORECLOSURE
  BANKRUPTCY
  STUDENT_LOAN_DELINQUENCY
  MEDICAL_COLLECTION
  UTILITY_COLLECTION
  RENTAL_DEBT
  TELECOM_DEBT
  HARD_INQUIRY
  PERSONAL_INFO_ISSUE
  DUPLICATE_ACCOUNT
  MIXED_FILE
  IDENTITY_THEFT_ITEM
  OTHER_ADVERSE
}

enum NegativeItemStatus {
  IDENTIFIED
  RESEARCHING
  ELIGIBLE_FOR_DISPUTE
  DOCUMENTATION_NEEDED
  READY
  SENT
  PENDING
  VERIFIED
  UPDATED
  DELETED
  CORRECTED
  ESCALATED
  CLOSED
}

enum DisputeReasonType {
  INACCURATE_INFO
  INCOMPLETE_REPORTING
  DUPLICATE_REPORTING
  OBSOLETE_REPORTING
  MIXED_FILE
  UNAUTHORIZED_INQUIRY
  IDENTITY_THEFT
  INCORRECT_BALANCE
  INCORRECT_STATUS
  INCORRECT_PAYMENT_HISTORY
  INCORRECT_DATES
  INCORRECT_OWNERSHIP
  FURNISHER_VERIFICATION
  REINSERTION_REVIEW
}

enum LetterType {
  EXPERIAN_DISPUTE
  EQUIFAX_DISPUTE
  TRANSUNION_DISPUTE
  FURNISHER_DIRECT_DISPUTE
  IDENTITY_THEFT_BLOCK_REQUEST
  PERSONAL_INFO_CORRECTION
  INQUIRY_DISPUTE
  REINVESTIGATION_REQUEST
  METHOD_OF_VERIFICATION_REQUEST
  REINSERTION_DISPUTE
  FOLLOW_UP
  CFPB_ESCALATION
  GENERAL_CORRESPONDENCE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AutomationTrigger {
  CLIENT_ENROLLED
  ALL_REPORTS_UPLOADED
  AUDIT_COMPLETED
  DISPUTE_APPROVED
  DISPUTE_MAILED
  BUREAU_RESPONSE_UPLOADED
  ACCOUNT_DELETED
  ACCOUNT_VERIFIED
  DEADLINE_APPROACHING
  DEADLINE_OVERDUE
}

enum ActionRiskLevel {
  ROUTINE
  LEGALLY_CONSEQUENTIAL
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  OVERDUE
  REFUNDED
  WAIVED
}

// ---------------------------------------------------------------
// Users / Employees / Clients
// ---------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee?
  clientLink    Client?          @relation("ClientUser")
  assignedTasks Task[]           @relation("TaskAssignee")
  createdBy_    AuditLog[]       @relation("AuditActor")
  messages      Message[]        @relation("MessageSender")
  notifications Notification[]

  @@map("users")
}

model Employee {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedClients Client[] @relation("AssignedSpecialist")

  @@map("employees")
}

model Client {
  id               String       @id @default(uuid())
  userId           String?      @unique
  user             User?        @relation("ClientUser", fields: [userId], references: [id])

  firstName        String
  middleName       String?
  lastName         String
  dateOfBirth      DateTime?
  ssnEncrypted     String?      // application-layer encrypted; never logged, never bulk-exported
  email            String?
  phone            String?
  employer         String?

  enrollmentDate   DateTime     @default(now())
  status           ClientStatus @default(LEAD)

  assignedSpecialistId String?
  assignedSpecialist   Employee? @relation("AssignedSpecialist", fields: [assignedSpecialistId], references: [id])

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  addresses        ClientAddress[]
  documents        ClientDocument[]
  creditReports     CreditReport[]
  creditScores      CreditScore[]
  negativeItems     NegativeItem[]
  disputes          Dispute[]
  identityTheftCases IdentityTheftCase[]
  tasks             Task[]
  messages          Message[]
  activityLogs      ActivityLog[]
  complianceRecords ComplianceRecord[]
  payments          Payment[]

  @@index([status])
  @@index([assignedSpecialistId])
  @@map("clients")
}

model ClientAddress {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("client_addresses")
}

// ---------------------------------------------------------------
// Documents
// ---------------------------------------------------------------

model ClientDocument {
  id          String            @id @default(uuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id])
  category    DocumentCategory
  storageKey  String            // S3 object key — never a guessable/public path
  fileName    String
  mimeType    String
  version     Int               @default(1)
  uploadedById String?
  createdAt   DateTime          @default(now())

  @@index([clientId, category])
  @@map("client_documents")
}

// ---------------------------------------------------------------
// Credit Reports / Tradelines / Scores
// ---------------------------------------------------------------

model CreditReport {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  bureau     Bureau
  reportDate DateTime
  rawFileKey String?  // original imported/uploaded file in storage
  createdAt  DateTime @default(now())

  tradelines Tradeline[]
  inquiries  CreditInquiry[]

  @@index([clientId, bureau, reportDate])
  @@map("credit_reports")
}

model Tradeline {
  id                  String   @id @default(uuid())
  creditReportId      String
  creditReport        CreditReport @relation(fields: [creditReportId], references: [id])
  creditorName        String
  furnisherName        String?
  accountName          String
  accountNumberMasked  String?
  accountType          String?
  accountStatus        String?
  openDate             DateTime?
  closedDate           DateTime?
  balance              Decimal? @db.Decimal(12, 2)
  creditLimit          Decimal? @db.Decimal(12, 2)
  pastDueAmount        Decimal? @db.Decimal(12, 2)
  paymentStatus        String?
  monthlyPayment       Decimal? @db.Decimal(12, 2)
  lastPaymentDate      DateTime?
  dateUpdated          DateTime?
  dateOfFirstDelinquency DateTime?
  paymentHistory       Json?
  remarks              String?
  collectionStatus     String?
  chargeOffStatus      String?
  responsibility       String?
  disputeStatus        String?
  createdAt            DateTime @default(now())

  negativeItems NegativeItemTradeline[]

  @@map("tradelines")
}

model CreditInquiry {
  id             String   @id @default(uuid())
  creditReportId String
  creditReport   CreditReport @relation(fields: [creditReportId], references: [id])
  inquirerName   String
  inquiryDate    DateTime
  isAuthorized   Boolean?
  createdAt      DateTime @default(now())

  @@map("credit_inquiries")
}

model CreditScore {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  bureau    Bureau
  score     Int
  snapshotDate DateTime
  createdAt DateTime @default(now())

  @@index([clientId, bureau, snapshotDate])
  @@map("credit_scores")
}

// ---------------------------------------------------------------
// Negative Items / Disputes
// ---------------------------------------------------------------

model NegativeItem {
  id                String             @id @default(uuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  category          NegativeCategory
  status            NegativeItemStatus @default(IDENTIFIED)
  furnisherName     String?
  bureau            Bureau?
  disputeReason     String?
  supportingEvidence String?
  firstDisputedDate DateTime?
  mostRecentDisputeDate DateTime?
  disputeRoundCount Int                @default(0)
  bureauResponse    String?
  furnisherResponse String?
  result            String?
  deletedDate       DateTime?
  correctedDate     DateTime?
  escalationStatus  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tradelines        NegativeItemTradeline[]
  disputeItems       DisputeItem[]

  @@index([clientId, status])
  @@map("negative_items")
}

// join table: one negative item can span multiple raw tradeline rows (mixed file, duplicate account)
model NegativeItemTradeline {
  negativeItemId String
  negativeItem   NegativeItem @relation(fields: [negativeItemId], references: [id])
  tradelineId    String
  tradeline      Tradeline    @relation(fields: [tradelineId], references: [id])

  @@id([negativeItemId, tradelineId])
  @@map("negative_item_tradelines")
}

model Dispute {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  bureau     Bureau
  createdAt  DateTime @default(now())

  rounds     DisputeRound[]

  @@map("disputes")
}

model DisputeRound {
  id               String   @id @default(uuid())
  disputeId        String
  dispute          Dispute  @relation(fields: [disputeId], references: [id])
  roundNumber      Int
  createdDate      DateTime @default(now())
  approvedDate     DateTime?
  approvedById     String?
  sentDate         DateTime?
  deliveryDate     DateTime?
  responseDeadline DateTime?
  bureauResponse   String?
  results          String?
  nextRecommendedAction String?

  items    DisputeItem[]
  letters  DisputeLetter[]
  packages DisputePackage[]
  bureauResponses    BureauResponse[]
  furnisherResponses FurnisherResponse[]

  @@index([disputeId, roundNumber])
  @@map("dispute_rounds")
}

model DisputeItem {
  id             String            @id @default(uuid())
  disputeRoundId String
  disputeRound   DisputeRound      @relation(fields: [disputeRoundId], references: [id])
  negativeItemId String
  negativeItem   NegativeItem      @relation(fields: [negativeItemId], references: [id])
  reasonType     DisputeReasonType
  supportingFacts String?
  createdAt      DateTime          @default(now())

  @@map("dispute_items")
}

model DisputeLetter {
  id             String     @id @default(uuid())
  disputeRoundId String
  disputeRound   DisputeRound @relation(fields: [disputeRoundId], references: [id])
  letterType     LetterType
  templateId     String?
  template       TemplateDocument? @relation(fields: [templateId], references: [id])
  version        Int        @default(1)
  fileKey        String?    // generated PDF in storage
  createdAt      DateTime   @default(now())

  @@map("dispute_letters")
}

model DisputePackage {
  id             String   @id @default(uuid())
  disputeRoundId String
  disputeRound   DisputeRound @relation(fields: [disputeRoundId], references: [id])
  fileKey        String?  // compiled PDF package
  mailProvider   String?
  certifiedMailNumber String?
  trackingNumber String?
  mailedDate     DateTime?
  deliveredDate  DateTime?
  deliveryProofKey String?
  createdAt      DateTime @default(now())

  @@map("dispute_packages")
}

model BureauResponse {
  id             String   @id @default(uuid())
  disputeRoundId String?
  disputeRound   DisputeRound? @relation(fields: [disputeRoundId], references: [id])
  bureau         Bureau
  responseDate   DateTime
  fileKey        String?
  summary        String?
  createdAt      DateTime @default(now())

  @@map("bureau_responses")
}

model FurnisherResponse {
  id             String   @id @default(uuid())
  disputeRoundId String?
  disputeRound   DisputeRound? @relation(fields: [disputeRoundId], references: [id])
  furnisherName  String
  responseDate   DateTime
  fileKey        String?
  summary        String?
  createdAt      DateTime @default(now())

  @@map("furnisher_responses")
}

// ---------------------------------------------------------------
// Identity Theft (§605B) — never AI-initiated, gated on client statement
// ---------------------------------------------------------------

model IdentityTheftCase {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  affectedAccounts String? // JSON list of tradeline/negative item references
  documentsChecklist Json  // configurable checklist + completion state
  requestGeneratedDate DateTime?
  submittedDate   DateTime?
  deliveredDate   DateTime?
  bureauResponse  String?
  blockStatus     String?
  reinsertionStatus String?
  followUpRequired Boolean @default(false)
  createdAt       DateTime @default(now())

  @@map("identity_theft_cases")
}

// ---------------------------------------------------------------
// Tasks / Notifications / Messages
// ---------------------------------------------------------------

model Task {
  id           String       @id @default(uuid())
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  title        String
  notes        String?
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(OPEN)
  dueDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, status])
  @@map("tasks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Message {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------
// Automation
// ---------------------------------------------------------------

model AutomationRule {
  id               String            @id @default(uuid())
  name             String
  triggerEvent     AutomationTrigger
  conditions       Json?
  actions          Json              // ordered list of action definitions
  riskLevel        ActionRiskLevel   @default(ROUTINE)
  requiresApproval Boolean           @default(false)
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  events AutomationEvent[]

  @@map("automation_rules")
}

model AutomationEvent {
  id               String         @id @default(uuid())
  ruleId           String
  rule             AutomationRule @relation(fields: [ruleId], references: [id])
  clientId         String?
  firedAt          DateTime       @default(now())
  executed         Boolean
  heldForReview    Boolean        @default(false)
  resultActionIds  Json?

  @@map("automation_events")
}

// ---------------------------------------------------------------
// Templates / Compliance / Audit
// ---------------------------------------------------------------

model TemplateDocument {
  id        String     @id @default(uuid())
  name      String
  letterType LetterType
  bodyTemplate String  // supports {{variable}} tokens
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  letters DisputeLetter[]

  @@map("template_documents")
}

model Payment {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(UNPAID)
  dueDate       DateTime?
  paidDate      DateTime?
  method        String?       // "Card", "ACH", "Check", "Cash", etc. — free text, not a payment processor integration yet
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  invoiceLabel  String?       // e.g. "Month 1", "Setup Fee", "Round 2 Service Fee"
  notes         String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId, status])
  @@map("payments")
}

model ComplianceRecord {
  id           String   @id @default(uuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  checkpoint   String   // e.g. "package_review", "identity_theft_documentation"
  reviewedById String?
  approved     Boolean
  notes        String?
  createdAt    DateTime @default(now())

  @@map("compliance_records")
}

model ActivityLog {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  actorId     String?  // user id, nullable for system automation
  actorType   String   // "user" | "automation"
  description String
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String?
  previousValue Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
